# Copy to .env for local development. Never commit .env.

# Environment: dev | prod
ENV=dev

# Postgres (used by docker-compose.yml and the backend)
POSTGRES_USER=changeloom
POSTGRES_PASSWORD=changeloom
POSTGRES_DB=changeloom
POSTGRES_PORT=5433
DATABASE_URL=postgres://changeloom:changeloom@localhost:5433/changeloom?sslmode=disable

# API server
FIREBASE_PROJECT_ID=

HTTP_ADDR=:8080
LOG_LEVEL=info

# Timeline: stories older than this many days are hidden
TIMELINE_WINDOW_DAYS=60

# Ingestion: feed items older than this many days are skipped
INGEST_MAX_ITEM_AGE_DAYS=30

# AI processing (worker). ANTHROPIC_API_KEY is a secret: keep it in .env only.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# low | medium | high | xhigh | max
AI_EFFORT=low
# Tokens (input + output) submitted per rolling 24h; submission pauses once reached
AI_DAILY_TOKEN_BUDGET=2000000
# Max raw items per batch
AI_BATCH_MAX_ITEMS=100
# Failed attempts before an item is marked failed
AI_MAX_ATTEMPTS=3
# Raw content longer than this many characters is trimmed (and logged) before sending
AI_INPUT_MAX_CHARS=24000
AI_MAX_OUTPUT_TOKENS=8000
# A new item joins an existing story about the same CVE / project+version from this many days back
AI_MERGE_WINDOW_DAYS=7
# Near-duplicate story merging (Claude, runs every 10 minutes): max stories checked per run
AI_DEDUPE_MAX_PER_RUN=10

# Web discovery agent (Claude + web search). OFF by default: every run costs searches + tokens.
AI_DISCOVERY_ENABLED=false
AI_DISCOVERY_MAX_SEARCHES=8
AI_DISCOVERY_INTERVAL_HOURS=24

# Push notifications for high/critical security stories (worker). Needs FIREBASE_PROJECT_ID and
# Application Default Credentials for a service account allowed to send FCM messages:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json (secret: keep out of git)
FCM_ENABLED=false
