# Copy to .env for local development. Never commit .env.

# Environment: dev (local, dev auth) | staging | prod (Firebase auth; hosted settings live in deploy/)
ENV=dev

# Dev Postgres: docker (docker-compose.yml, `make db-up` starts it) or local (an installed server).
# For local, point DATABASE_URL at it (usually port 5432) and create the role and database once:
#   createuser --createdb --pwprompt changeloom && createdb --owner changeloom changeloom
# The role needs CREATEDB: tests and `make curator-db` create databases. Also update
# LOCAL_DATABASE_URL in curator/.env to the same server.
POSTGRES_MODE=docker

# Postgres (used by docker-compose.yml and the backend)
POSTGRES_USER=changeloom
POSTGRES_PASSWORD=changeloom
POSTGRES_DB=changeloom
POSTGRES_PORT=5433
DATABASE_URL=postgres://changeloom:changeloom@localhost:5433/changeloom?sslmode=disable

# API server
FIREBASE_PROJECT_ID=changeloom

HTTP_ADDR=:8080
LOG_LEVEL=info
# Max database connections per api instance (keep instances x this under the database's limit)
DB_MAX_CONNS=10
# Close pooled connections idle this long, checked this often; keep the sum under Neon's
# 5-minute scale-to-zero, which drops every connection
DB_MAX_CONN_IDLE_TIME=3m
DB_HEALTH_CHECK_PERIOD=30s
# Upper bound on each request, including its queries and the push fan-out of /internal/notify
REQUEST_TIMEOUT=30s

# Timeline: stories older than this many days are hidden (keep it at or below the curator's
# CURATOR_PRUNE_MAX_AGE_DAYS)
TIMELINE_WINDOW_DAYS=14
# Timeline ranking of unread stories: points between the tiers (followed, profession), per importance level (1-5) and per severity level above low; one
# point lost per TIMELINE_DECAY_HOURS of age; TIMELINE_SEEN_PENALTY points lost by a story on
# screen more than TIMELINE_SEEN_GRACE_HOURS ago but never opened or saved. Age runs from when the
# story was added, plus TIMELINE_FETCH_LAG_WEIGHT (0-1) of the time from publishing to adding it
# (1 ages stories from their publish time only).
TIMELINE_TIER_WEIGHT=2
TIMELINE_IMPORTANCE_WEIGHT=1
TIMELINE_SEVERITY_WEIGHT=0.5
TIMELINE_DECAY_HOURS=24
TIMELINE_FETCH_LAG_WEIGHT=0.25
TIMELINE_SEEN_PENALTY=3
TIMELINE_SEEN_GRACE_HOURS=12
# Points an unread story gains when readers must upgrade, migrate or patch (the curator's action_required)
TIMELINE_ACTION_WEIGHT=1
# Topic affinity: over the last TIMELINE_AFFINITY_DAYS, a followed topic whose stories the user
# opens or saves more often than their stories overall gains up to TIMELINE_AFFINITY_WEIGHT points
# (and one they skip or dismiss loses up to as many); TIMELINE_AFFINITY_PRIOR pseudo-stories at the
# user's overall rate damp topics with little history.
TIMELINE_AFFINITY_WEIGHT=1.5
TIMELINE_AFFINITY_DAYS=30
TIMELINE_AFFINITY_PRIOR=4
# A story the user asked "More like this" for counts as this many opened stories for its topics.
TIMELINE_BOOST_ENGAGEMENTS=3
# Each timeline page is re-ordered so that at most TIMELINE_MAX_TOPIC_RUN stories in a row share a
# root topic.
TIMELINE_MAX_TOPIC_RUN=2
# A story's thread (GET /v1/stories/{id}): up to STORY_THREAD_LIMIT (at most 50) other stories of the
# last STORY_THREAD_DAYS about the same project or CVE.
STORY_THREAD_DAYS=180
STORY_THREAD_LIMIT=6
# Topic suggestions (GET /v1/me/topic-suggestions): up to TOPIC_SUGGESTION_LIMIT (at most 20) topics
# with a story in the last TOPIC_SUGGESTION_DAYS.
TOPIC_SUGGESTION_DAYS=7
TOPIC_SUGGESTION_LIMIT=5

# Max pending topic requests per user
TOPIC_REQUEST_MAX_PENDING=10
# Feedback messages one user can send per 24 hours.
FEEDBACK_MAX_PER_DAY=5

# Rate limits in requests per minute, per api instance: per client IP (all routes but health
# checks) and per signed-in user (/v1). Each allows a burst of the full minute's requests.
RATE_LIMIT_IP_PER_MIN=300
RATE_LIMIT_USER_PER_MIN=120

# Firebase App Check. Dev never checks tokens, so this must stay false here.
APPCHECK_ENFORCE=false

# Tracing to Cloud Trace over OTLP. Off locally; when on, it needs FIREBASE_PROJECT_ID (the GCP
# project traces go to) and Application Default Credentials (`gcloud auth application-default login`).
OTEL_ENABLED=false
# Fraction of requests traced (0 to 1)
OTEL_SAMPLE_RATIO=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=https://telemetry.googleapis.com

# Shared secret for POST /internal/notify (called by the curator after a sync). Secret: keep it
# in .env only. Leave empty to disable the route.
NOTIFY_SECRET=

# Push notifications for high/critical security stories (sent by the api on /internal/notify). Needs FIREBASE_PROJECT_ID and
# Application Default Credentials for a service account allowed to send FCM messages:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json (secret: keep out of git)
FCM_ENABLED=false
