<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme behind Compose: matches the dark `bg` token so launch has no white flash. -->
    <style name="Theme.Changeloom" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/changeloom_bg</item>
        <item name="android:colorBackground">@color/changeloom_bg</item>
    </style>

    <!-- Launch theme for MainActivity (core-splashscreen), which switches to Theme.Changeloom in installSplashScreen.
         Before API 31 the icon is static: the animated one (values-v31) starts undrawn. -->
    <style name="Theme.Changeloom.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/changeloom_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Changeloom</item>
    </style>

    <color name="changeloom_bg">#FF070709</color>
</resources>
