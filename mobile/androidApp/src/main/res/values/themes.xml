<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme behind Compose: matches the dark `bg` token so launch has no white flash. -->
    <style name="Theme.Changeloom" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/changeloom_bg</item>
        <item name="android:colorBackground">@color/changeloom_bg</item>
    </style>

    <!-- Launch theme for MainActivity, which switches to Theme.Changeloom in onCreate. Before API 31 the window
         background is the splash; from 31 the platform splash in values-v31 takes over. -->
    <style name="Theme.Changeloom.Splash">
        <item name="android:windowBackground">@drawable/splash_window</item>
    </style>

    <color name="changeloom_bg">#FF070709</color>
</resources>
