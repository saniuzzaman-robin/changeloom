# Copy to deploy/.env on the server. Never commit .env.

# Public hostname Caddy serves (DNS must point at this host; TLS is automatic)
API_DOMAIN=api.example.com

# Postgres. The password is a secret: generate a long random value.
POSTGRES_USER=changeloom
POSTGRES_PASSWORD=
POSTGRES_DB=changeloom
# Must match the values above; host is the compose service name
DATABASE_URL=postgres://changeloom:CHANGE_ME@postgres:5432/changeloom?sslmode=disable

# Required in prod: Firebase project whose ID tokens the API accepts
FIREBASE_PROJECT_ID=

LOG_LEVEL=info
TIMELINE_WINDOW_DAYS=60
INGEST_MAX_ITEM_AGE_DAYS=30

# AI processing (worker); leave AI_API_KEY empty to only ingest
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=
AI_DAILY_TOKEN_BUDGET=2000000
AI_BATCH_MAX_ITEMS=100
AI_MAX_ATTEMPTS=3
AI_INPUT_MAX_CHARS=24000
AI_MAX_OUTPUT_TOKENS=8000
AI_MERGE_WINDOW_DAYS=7

# Backups (deploy/backup.sh)
BACKUP_DIR=/var/backups/changeloom
BACKUP_KEEP=14
