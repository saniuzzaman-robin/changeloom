# Cloud Run environment for the api service. Never commit real values.
# Cloud Run sets PORT itself; the api listens on it.

ENV=prod

# Neon *pooled* connection string. Secret: pass it via Secret Manager.
DATABASE_URL=

# Required in prod: Firebase project whose ID tokens the api accepts
FIREBASE_PROJECT_ID=

# Push notifications for high/critical security stories, sent on POST /internal/notify.
# Uses the Cloud Run service account's credentials, which must be allowed to send FCM messages.
FCM_ENABLED=false

# Shared secret the curator sends to POST /internal/notify. Secret: pass it via Secret Manager.
# Leave empty to disable the route.
NOTIFY_SECRET=

LOG_LEVEL=info
TIMELINE_WINDOW_DAYS=60
