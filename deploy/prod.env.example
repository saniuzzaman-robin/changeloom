# Production deploy settings, read by deploy/deploy-api.sh (`make deploy-api DEPLOY_ENV=prod`).
# Copy to deploy/prod.env (gitignored) and fill in. Never put secret values here: DATABASE_URL
# and NOTIFY_SECRET live in Secret Manager and are referenced by name.
# The script sets ENV=prod itself; Cloud Run sets PORT, and the api listens on it.

# --- Where to deploy ---
# The production GCP project, which is also the production Firebase project.
GCP_PROJECT=
# Cloud Run region; keep it near the Neon region (e.g. us-east4 with Neon aws-us-east-1).
GCP_REGION=us-east4
CLOUD_RUN_SERVICE=changeloom-api
# Runtime service account; it needs roles/secretmanager.secretAccessor on the secrets below and,
# with FCM_ENABLED=true, permission to send FCM messages (see deploy/README.md).
SERVICE_ACCOUNT=
MIN_INSTANCES=0
MAX_INSTANCES=2

# --- Secrets (Secret Manager names in GCP_PROJECT; the latest version is used) ---
# Holds the production Neon *pooled* connection string.
DATABASE_URL_SECRET=changeloom-database-url
# Holds the shared secret the curator sends to POST /internal/notify. Leave empty to disable the route.
NOTIFY_SECRET_SECRET=changeloom-notify-secret

# --- api runtime settings ---
# Firebase project whose ID tokens the api accepts (normally GCP_PROJECT).
FIREBASE_PROJECT_ID=
# Push notifications for high/critical security stories, sent on POST /internal/notify.
FCM_ENABLED=false
LOG_LEVEL=info
TIMELINE_WINDOW_DAYS=60
TOPIC_REQUEST_MAX_PENDING=10

# --- Tracing (Cloud Trace over OTLP; needs the setup in deploy/README.md, Monitoring) ---
OTEL_ENABLED=false
# Fraction of requests traced.
OTEL_SAMPLE_RATIO=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=https://telemetry.googleapis.com
