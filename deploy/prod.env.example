# Production deploy settings, read by deploy/deploy-api.sh (`make deploy-api DEPLOY_ENV=prod`).
# Copy to deploy/prod.env (gitignored) and fill in. Never put secret values here: DATABASE_URL
# and NOTIFY_SECRET live in Secret Manager and are referenced by name.
# The script sets ENV=prod itself; Cloud Run sets PORT, and the api listens on it.
# The deploy workflow (.github/workflows/deploy-api.yml) reads the same file from the GitHub
# environment variable DEPLOY_ENV_FILE: update it whenever this file changes (deploy/README.md).

# --- Where to deploy ---
# The production GCP project, which is also the production Firebase project.
GCP_PROJECT=
# Cloud Run region; keep it near the Neon region (e.g. us-east4 with Neon aws-us-east-1).
GCP_REGION=us-east4
CLOUD_RUN_SERVICE=changeloom-api
# Runtime service account; it needs roles/secretmanager.secretAccessor on the secrets below and,
# with FCM_ENABLED=true, permission to send FCM messages (see deploy/README.md).
SERVICE_ACCOUNT=

# --- Cloud Run instances ---
# One warm instance avoids cold starts; it is billed while idle.
MIN_INSTANCES=1
MAX_INSTANCES=2
# Requests one instance serves at once; keep DB_MAX_CONNS in mind.
CONCURRENCY=80
CPU=1
MEMORY=512Mi
# Cloud Run request timeout; above the api's own limit (REQUEST_TIMEOUT plus 5s).
TIMEOUT=60s
# Extra CPU while an instance starts (true or false).
CPU_BOOST=true
# Probe settings (gcloud --startup-probe / --liveness-probe); /health doesn't touch the DB.
STARTUP_PROBE=httpGet.path=/health,periodSeconds=2,timeoutSeconds=2,failureThreshold=15
LIVENESS_PROBE=httpGet.path=/health,periodSeconds=30,timeoutSeconds=3,failureThreshold=3

# --- Secrets (Secret Manager names in GCP_PROJECT, each pinned to a version number) ---
# After adding a secret version, bump its *_VERSION here and redeploy.
# Holds the production Neon *pooled* connection string.
DATABASE_URL_SECRET=changeloom-database-url
DATABASE_URL_SECRET_VERSION=1
# Holds the shared secret the curator sends to POST /internal/notify. Leave empty to disable the route.
NOTIFY_SECRET_SECRET=changeloom-notify-secret
NOTIFY_SECRET_SECRET_VERSION=1

# --- api runtime settings ---
# Firebase project whose ID tokens the api accepts (normally GCP_PROJECT).
FIREBASE_PROJECT_ID=
# Push notifications for high/critical security stories, sent on POST /internal/notify.
FCM_ENABLED=false
LOG_LEVEL=info
TIMELINE_WINDOW_DAYS=60
TOPIC_REQUEST_MAX_PENDING=10
# Postgres connections per instance (Neon pooled URL).
DB_MAX_CONNS=10
REQUEST_TIMEOUT=30s
# Per instance, per minute.
RATE_LIMIT_IP_PER_MIN=300
RATE_LIMIT_USER_PER_MIN=120
# Reject /v1 requests without a valid Firebase App Check token (403). Leave false until the
# "app check would reject" log lines show only old app versions (deploy/README.md, App Check).
APPCHECK_ENFORCE=false

# --- Tracing (Cloud Trace over OTLP; needs the setup in deploy/README.md, Monitoring) ---
OTEL_ENABLED=false
# Fraction of requests traced.
OTEL_SAMPLE_RATIO=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=https://telemetry.googleapis.com

# --- Deploy workflow only (see deploy/README.md, Continuous deployment) ---
# Artifact Registry docker repository in GCP_PROJECT/GCP_REGION that holds the api images.
ARTIFACT_REPO=changeloom
# Holds the *direct* (non-pooled) Neon URL, used to run migrations; pinned like the secrets above.
MIGRATE_DATABASE_URL_SECRET=changeloom-migrate-database-url
MIGRATE_DATABASE_URL_SECRET_VERSION=1
