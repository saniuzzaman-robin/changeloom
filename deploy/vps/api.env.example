# The prod api's environment on the VPS. Copy to /srv/changeloom/api.env (mode 600, deploy user) and fill
# in the secrets; never commit the filled-in file. Values mirror deploy/prod.env, which stays the source for
# Cloud Run: change a setting in both while both run. Plain KEY=value lines, no quotes (compose env_file).
# GOOGLE_APPLICATION_CREDENTIALS is set in compose.yaml to the mounted /srv/changeloom/fcm.json.

ENV=prod

# --- Secrets ---
# The production Neon *pooled* connection string (same value as the changeloom-database-url secret).
DATABASE_URL=postgres://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
# The shared secret the curator sends to POST /internal/notify (same as changeloom-notify-secret).
# Leave empty to disable the route.
NOTIFY_SECRET=

# --- api runtime settings ---
FIREBASE_PROJECT_ID=changeloom-prod-510511
FCM_ENABLED=true
LOG_LEVEL=info
TIMELINE_WINDOW_DAYS=60
TOPIC_REQUEST_MAX_PENDING=10
DB_MAX_CONNS=10
REQUEST_TIMEOUT=30s
RATE_LIMIT_IP_PER_MIN=300
RATE_LIMIT_USER_PER_MIN=120
APPCHECK_ENFORCE=false
# Tracing stays off on the VPS (no Cloud Trace credentials here).
OTEL_ENABLED=false
