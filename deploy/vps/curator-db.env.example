# The nightly curator's own Postgres (curator-db in curator.compose.yaml). Copy to
# /srv/changeloom/curator-db.env (mode 600, deploy user) and set a password; never commit the filled-in file.
# LOCAL_DATABASE_URL in curator.env uses the same user, password and database. Read only when the volume
# is first created. Plain KEY=value lines, no quotes (compose env_file).
POSTGRES_USER=curator
POSTGRES_PASSWORD=
POSTGRES_DB=curator
