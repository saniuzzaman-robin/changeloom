# Read only by deploy.sh to run goose; the api container never sees it. Copy to /srv/changeloom/migrate.env
# (mode 600, deploy user). Plain KEY=value, no quotes.
# The production Neon *direct* (non-pooled) URL, same as the changeloom-migrate-database-url secret.
MIGRATE_DATABASE_URL=postgres://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require
