# The nightly prod curator's environment on the VPS (curator/deploy/job.sh). Copy to
# /srv/changeloom/curator.env (mode 600, deploy user) and fill in the secrets; never commit the filled-in file.
# Plain KEY=value lines, no quotes (compose env_file). Every other setting keeps its default from
# curator/.env.example. job.sh sets CURATOR_AI_PROVIDER=claude and CURATOR_RUN_ENVS=prod itself.

# --- Secrets ---
# From `claude setup-token` on a machine logged in to the subscription.
CLAUDE_CODE_OAUTH_TOKEN=
# The job's own database (curator.compose.yaml); USER, PASSWORD and DB match curator-db.env.
LOCAL_DATABASE_URL=postgres://curator:PASSWORD@curator-db:5432/curator?sslmode=disable
# The production Neon *direct* (non-pooled) URL, for the demand pull, sync and prune.
REMOTE_DATABASE_URL_PROD=postgres://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require
# The prod api's NOTIFY_SECRET (api.env), sent to POST /internal/notify after a sync.
NOTIFY_SECRET_PROD=

# --- Settings ---
API_BASE_URL_PROD=https://changeloom-api.saniuzzaman.dev
# The cheapest model, so a night's run uses the subscription's limits the slowest.
CLAUDE_MODEL=haiku
# A topic fetched in the last 2 days is skipped, so the next night covers what a run cut short missed.
CURATOR_FETCH_COOLDOWN=48h
CURATOR_CONCURRENCY=2
LOG_LEVEL=info
