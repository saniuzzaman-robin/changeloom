<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs `curator run --full` once a day at 11:00. launchd runs a missed job when the Mac wakes. --full
  covers every topic in one run, so there is no RunAtLoad (it would start a full run at every login).
  Template: replace __REPO__ with the absolute path of this repo and __HOME__ with your home
  directory, then install:
    make curator-build
    sed -e "s|__REPO__|$PWD|g" -e "s|__HOME__|$HOME|g" curator/launchd/dev.changeloom.curator.plist \
      > ~/Library/LaunchAgents/dev.changeloom.curator.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.changeloom.curator.plist
  Remove with: launchctl bootout gui/$(id -u)/dev.changeloom.curator
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.changeloom.curator</string>
    <!--
      A login shell finds `claude` on PATH; curator/.env supplies the settings. Claude runs with the
      claude-personal profile (CLAUDE_CONFIG_DIR=~/.claude-personal, as the shell alias sets it) unless
      .env sets CLAUDE_CONFIG_DIR. Its KEY=value lines are
      exported as-is rather than sourced: Make reads the same file, so values stay unquoted, and a
      Neon URL's `&` would break `. ./.env`.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>[ -s "$HOME/.nvm/nvm.sh" ] &amp;&amp; . "$HOME/.nvm/nvm.sh"; cd __REPO__/curator &amp;&amp; export $(grep -E '^[A-Z_]+=' .env | xargs) &amp;&amp; export CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude-personal}" &amp;&amp; exec ./bin/curator run --full</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer></dict>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/changeloom-curator.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/changeloom-curator.log</string>
</dict>
</plist>
