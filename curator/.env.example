# Copy to curator/.env (the Makefile's curator-* targets load it). Never commit .env.

# The curator's own Postgres: database changeloom_curator on the dev Postgres (`make db-up curator-db`).
# Use the same server as the root DATABASE_URL (port 5433 for POSTGRES_MODE=docker; your
# installed server's port, usually 5432, for POSTGRES_MODE=local).
LOCAL_DATABASE_URL=postgres://changeloom:changeloom@localhost:5433/changeloom_curator?sslmode=disable

# Hosted environments (staging, prod), picked with --env (`make migrate-remote DEPLOY_ENV=...`).
# REMOTE_DATABASE_URL_<ENV>: that env's Neon direct (non-pooled) URL, for `migrate --remote`,
# `requests pull` and `sync`. API_BASE_URL_<ENV>: that env's Cloud Run URL, called on
# POST /internal/notify after a sync. NOTIFY_SECRET_<ENV>: the same value as that env's
# NOTIFY_SECRET in Secret Manager. Secrets: keep them in .env only.
REMOTE_DATABASE_URL_STAGING=
API_BASE_URL_STAGING=
NOTIFY_SECRET_STAGING=

REMOTE_DATABASE_URL_PROD=
API_BASE_URL_PROD=
NOTIFY_SECRET_PROD=

# Backend goose migrations, relative to the working directory (the curator runs from curator/).
BACKEND_MIGRATIONS_DIR=../backend/migrations

LOG_LEVEL=info

# AI backend for fetch/backfill/requests group: claude (default, your Claude subscription) or openai
# (any OpenAI-compatible API)
CURATOR_AI_PROVIDER=claude
# Overrides the selected provider's model (CLAUDE_MODEL or OPENAI_MODEL) when set
# CURATOR_AI_MODEL=
# Prompt wording: frontier (large models) or compact (shorter, explicit research steps for smaller models).
# Defaults to frontier with claude and compact with openai.
# CURATOR_PROMPT_STYLE=
# Minimum gap between the starts of two AI calls (Go duration; 0s disables). Use it to stay under rate limits
CURATOR_CALL_DELAY=0s
# OpenAI-compatible provider (OpenAI, OpenRouter, Groq, Perplexity, ...). The curator gives the model no
# tools, so pick a model that searches the web on its own (e.g. an OpenRouter ":online" model or a
# Perplexity Sonar model). The API key is sent as a Bearer token. OPENAI_MODEL is required with this provider.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
# Max duration of one call including its format retries (Go duration)
OPENAI_TIMEOUT=10m

# Claude CLI used for `claude -p` calls. Run `claude` once to log in with your subscription.
CLAUDE_BIN=claude
CLAUDE_MODEL=sonnet
# Claude account the calls run under (sets CLAUDE_CONFIG_DIR, overriding the shell's). Default ~/.claude-personal.
# CURATOR_CLAUDE_CONFIG_DIR=/Users/you/.claude-personal  (absolute path; ~ is not expanded)
# Max duration of one call (Go duration)
CLAUDE_TIMEOUT=10m

# Max Claude fetch calls per run, and topics per call
CURATOR_MAX_CALLS_PER_RUN=8
CURATOR_TOPICS_PER_CALL=5
# Max new topics created from user requests per run
CURATOR_MAX_NEW_TOPICS_PER_RUN=5
# Stories published longer ago than this are dropped (keep it at or below CURATOR_PRUNE_MAX_AGE_DAYS)
CURATOR_ITEM_MAX_AGE_DAYS=14
# A new story about the same CVE or project+version as one from this many days back is merged into it
CURATOR_MERGE_WINDOW_DAYS=14
# Stories asked for per topic in one fetch call (fewer when there is not enough real news)
CURATOR_STORIES_PER_TOPIC=5
# Claude calls that run at once (stores are serialised)
CURATOR_CONCURRENCY=2

# Fetch frequency by demand. Hot: this many distinct viewers of the topic's stories in the last 7
# days; fetched every run
CURATOR_HOT_MIN_VIEWS=1
# Warm: followed, or serves a user's profession, but not hot; fetched at most this often
CURATOR_WARM_INTERVAL_HOURS=24
# Cold: nobody follows or sees it; fetched at most this often
CURATOR_COLD_INTERVAL_HOURS=168

# Deal topics are fetched per country, for the countries users chose: at most this many countries
# (the ones with the most users) and this many Claude calls per run. Deals older than MAX_AGE days are
# dropped at fetch and pruned from the hosted DBs (saved ones stay)
CURATOR_DEALS_MAX_COUNTRIES=5
CURATOR_DEALS_MAX_CALLS_PER_RUN=4
CURATOR_DEALS_MAX_AGE_DAYS=7

# `curator backfill` fills leaf topics with fewer than this many recent stories
CURATOR_BACKFILL_TARGET=20
CURATOR_BACKFILL_TOPICS_PER_CALL=2
# Backfill calls `curator run` makes per run
CURATOR_BACKFILL_CALLS_PER_RUN=2

# Hosted envs `curator run` pulls from, syncs to and prunes (comma-separated: staging, prod)
CURATOR_RUN_ENVS=prod
# `curator run --if-due` (the launchd job) skips a run when the last successful fetch was under this many hours ago
CURATOR_RUN_MIN_GAP_HOURS=5

# `curator run` prunes each hosted DB this often. Unsaved stories published over MAX_AGE days ago are
# deleted; stories a user saved are never deleted
CURATOR_PRUNE_INTERVAL_DAYS=1
CURATOR_PRUNE_MAX_AGE_DAYS=14
