# Copy to curator/.env (the Makefile's curator-* targets load it). Never commit .env.

# The curator's own Postgres: database changeloom_curator on the dev Postgres (`make db-up curator-db`).
# Use the same server as the root DATABASE_URL (port 5433 for POSTGRES_MODE=docker; your
# installed server's port, usually 5432, for POSTGRES_MODE=local).
LOCAL_DATABASE_URL=postgres://changeloom:changeloom@localhost:5433/changeloom_curator?sslmode=disable

# Hosted environments (staging, prod), picked with --env (`make migrate-remote DEPLOY_ENV=...`).
# REMOTE_DATABASE_URL_<ENV>: that env's Neon direct (non-pooled) URL, for `migrate --remote`,
# `requests pull` and `sync`. API_BASE_URL_<ENV>: that env's Cloud Run URL, called on
# POST /internal/notify after a sync. NOTIFY_SECRET_<ENV>: the same value as that env's
# NOTIFY_SECRET in Secret Manager. Secrets: keep them in .env only.
REMOTE_DATABASE_URL_STAGING=
API_BASE_URL_STAGING=
NOTIFY_SECRET_STAGING=

REMOTE_DATABASE_URL_PROD=
API_BASE_URL_PROD=
NOTIFY_SECRET_PROD=

# Backend goose migrations, relative to the working directory (the curator runs from curator/).
BACKEND_MIGRATIONS_DIR=../backend/migrations

LOG_LEVEL=info

# Claude CLI used for `claude -p` calls. Run `claude` once to log in with your subscription.
CLAUDE_BIN=claude
CLAUDE_MODEL=sonnet
# Max duration of one call (Go duration)
CLAUDE_TIMEOUT=10m

# Max Claude fetch calls per run, and topics per call
CURATOR_MAX_CALLS_PER_RUN=8
CURATOR_TOPICS_PER_CALL=5
# Max new topics created from user requests per run
CURATOR_MAX_NEW_TOPICS_PER_RUN=5
# Stories published longer ago than this are dropped
CURATOR_ITEM_MAX_AGE_DAYS=7
# A new story about the same CVE or project+version as one from this many days back is merged into it
CURATOR_MERGE_WINDOW_DAYS=14
# Topics nobody follows are fetched at most this often; followed topics are fetched every run
CURATOR_UNFOLLOWED_INTERVAL_HOURS=24
